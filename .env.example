# Sign Up for LiveKit Cloud --> https://cloud.livekit.io
# Copy this file to .env.local and fill in the values.
# Both the web server (web/) and the agent (agent/) read this one file.
LIVEKIT_URL=<livekit-url>
LIVEKIT_API_KEY=<livekit-api-key>
LIVEKIT_API_SECRET=<livekit-api-secret>

# Gemini API key (https://aistudio.google.com/apikey).
# Used by the agent (Live session) and by the web server (voice preview,
# AI minutes). It is never sent to the browser.
GEMINI_API_KEY=<gemini-api-key>

# TypeSafe Jev API key (https://docs.typesafe.ai). Used by the agent only, for
# the off-topic detection. Without it the moderator still works, but going off
# topic is judged by the Live model alone and no confidence is shown.
JEV_API_KEY=<jev-api-key>

# --- optional ---------------------------------------------------------------

# Name the agent registers under. Set it (to the same value for web and agent)
# when you run the agent on your own machine, so your sessions are not
# dispatched to the deployed agent in the same LiveKit project.
# LIVEKIT_AGENT_NAME=smjar-dev

# Pins the agent's health-check port (random in dev mode otherwise).
# LIVEKIT_AGENT_PORT=8081

# Models used by the web server. The defaults are shown.
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts        # cheaper: gemini-3.8-flash-lite-tts
# GEMINI_MINUTES_MODEL=gemini-3.8-flash

# The company's AI gateway (OpenAI-compatible, e.g. a Cloudflare Worker in
# front of Workers AI). When set, the minutes are prepared there; Gemini is
# the fallback.
# AI_WORKER_URL=https://your-gateway.example.com/v1
# AI_WORKER_KEY=
# AI_WORKER_MODEL=glm-5.3-flash
# MINUTES_PROVIDER=worker     # or gemini: use only this one, no fallback

# Used by the agent for the off-topic detection and the interruptions.
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
# FAST_TRANSCRIPT=0       # judge on the Live model's transcript only (slower)
# SPOKEN_CLIPS=0          # let the Live model say the interruptions (waits for a pause)

# Gemini is not reachable from every region. Both sides honour the usual
# proxy variables.
# HTTPS_PROXY=http://127.0.0.1:7890
