# Sign Up for LiveKit Cloud --> https://cloud.livekit.io
# Copy this file to .env.local and fill in the values. it should match ../web/.env.local
LIVEKIT_URL=<livekit-url>
LIVEKIT_API_KEY=<livekit-api-key>
LIVEKIT_API_SECRET=<livekit-api-secret>
# Gemini API key (https://aistudio.google.com/apikey); read by the web server and handed to the agent
GEMINI_API_KEY=<gemini-api-key>
