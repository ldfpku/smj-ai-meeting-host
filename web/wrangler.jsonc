{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The web app on Cloudflare Workers, built by the OpenNext adapter.
  // Who may open it is decided by Cloudflare Access (Zero Trust) in front of
  // the domain, not by this Worker: see "Deployment" in the README.
  "name": "smj-meeting",
  "account_id": "35f7abfbdeb4851714ce57f480531c4a",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // next/image goes through /_next/image; with this binding Cloudflare Images
  // resizes and recompresses the pictures. Without it the originals are sent
  // unchanged and the Worker logs "env.IMAGES binding is not defined".
  "images": { "binding": "IMAGES" },
  // Text models (minutes, document import) run on Workers AI through this
  // binding: the only way the app calls a text model, no keys involved. The
  // binding belongs to the account pinned above. To route the calls through an
  // AI Gateway of that account, put its id in AI_GATEWAY_ID (requests are then
  // sent without cache and without log entries, see web/src/lib/ai-worker.ts).
  "ai": { "binding": "AI" },
  "vars": { "AI_GATEWAY_ID": "" },
  // Only the custom domain. A workers.dev or preview address would be a way
  // around the login.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "meeting.smjtools.com", "custom_domain": true }],
  // The API routes call Gemini, which refuses requests from some regions
  // (Hong Kong among them). Without this the Worker runs wherever the visitor
  // is; with it, in a Cloudflare data center next to this cloud region, which
  // is also where the LiveKit project lives.
  "placement": { "region": "gcp:us-west1" },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
